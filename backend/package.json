{
  "name": "uriesmooth-voice-backend",
  "version": "0.1.0",
  "description": "Real-time voice cloning and synthesis server with consent management",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "test": "jest --detectOpenHandles",
    "migrate": "node migrations/run.js",
    "seed": "node seeders/dev-seed.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\""
  },
  "keywords": [
    "voice-cloning",
    "speech-synthesis",
    "vac",
    "real-time",
    "consent-management"
  ],
  "author": "URIESMOOTH Voice Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.1.0",
    "bcrypt": "^5.1.1",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.6.1",
    "uuid": "^9.0.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.53.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
