# Backend Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/uriesmooth_voice
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uriesmooth_voice
DB_USER=voice_app
DB_PASSWORD=changeme

# JWT & Security
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRY=24h
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,electron://app

# Audio Processing (Mocked - ready for real services)
ASR_SERVICE_URL=http://localhost:5000
MT_SERVICE_URL=http://localhost:5001
TTS_SERVICE_URL=http://localhost:5002
ASR_TIMEOUT=30000
MT_TIMEOUT=20000
TTS_TIMEOUT=30000

# VAC (Voice Activity Detection)
VAC_THRESHOLD=0.5
VAC_MIN_DURATION_MS=200
VAC_ENABLED=true

# Voice Cloning
VOICE_SAMPLE_MAX_SIZE_MB=50
VOICE_SAMPLE_TIMEOUT=120000
GPU_ENABLED=false
GPU_DEVICE=cuda:0

# Consent & Legal
CONSENT_REQUIRED=true
DEVELOPMENT_SKIP_CONSENT=false
CONSENT_STORAGE_PATH=./data/consent_records
AUDIT_LOG_PATH=./logs/audit.log

# File Storage
AUDIO_UPLOAD_DIR=./audio/uploads
VOICE_SAMPLES_DIR=./audio/samples
RECORDINGS_DIR=./audio/recordings

# External Services (if using real integrations)
# GOOGLE_CLOUD_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Development Flags
DEBUG_AUDIO_PIPELINE=false
MOCK_SERVICES=true
SELF_CONSENT_MODE=true
